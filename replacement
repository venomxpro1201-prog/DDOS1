async def reffer(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    
    if user_id in used_referrals:
        await update.message.reply_text("❌ You have already used a referral code.")
        return

    if len(context.args) != 1:
        await update.message.reply_text("Usage: /reffer <referral_code>")
        return

    input_code = context.args[0]
    referrer_id = None

    # Find who the code belongs to
    for uid, data in approved_users.items():
        if data['ref_code'] == input_code:
            referrer_id = uid
            break

    if not referrer_id:
        await update.message.reply_text("❌ Invalid Referral Code.")
        return

    if referrer_id == user_id:
        await update.message.reply_text("❌ You cannot use your own code.")
        return

    # Grant rewards
    used_referrals.add(user_id)
    approve_user(user_id, 1) # New user gets 1 day
    approve_user(referrer_id, 2) # Referrer gets 2 days bonus
    
    await update.message.reply_text(f"✅ SUCCESS!\n🎁 You received 1 day access.\n🙌 Referrer @{referrer_id} received 2 days bonus.")

